{
  "name": "oier-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "python scripts/build_site_data.py",
    "test:data": "python -m unittest discover -s tests -v",
    "test": "npm run test:data && tsc -b",
    "build": "npm run data && tsc -b && vite build && node scripts/package_site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node tests/browser.mjs && node tests/experience.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.9",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
